<Project>

  <!--
    .NET analyzers, so the IDE and a command-line build report the same things.

    AnalysisMode Recommended is the middle setting: it keeps the rules Microsoft considers worth
    acting on and drops the opt-in pedantry (explicit defaults, logging-delegate performance,
    explicit interface surface). The three rules that this codebase trips by design rather than by
    accident - CA2007, CA1003 and CA1707 - are switched off in .editorconfig, next to the reasons.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>

    <!--
      The embedded audio and speech resources are English, so say so. This declares the neutral
      language for resource lookup and stops the framework probing for a culture-specific
      assembly that will never exist.
    -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    CS0067 is a compiler warning, not an analyzer rule, so .editorconfig's dotnet_diagnostic cannot
    switch it off. The two kibitzer events below have no producer yet - the work is mid-change rather
    than abandoned - so the warning is silenced for that project only. Delete this block when a
    producer lands and let the warning come back.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'UciComms'">
    <NoWarn>$(NoWarn);CS0067</NoWarn>
  </PropertyGroup>

  <!--
    Test-only analyzer noise. CA1062 wants argument guards on test methods whose parameters come
    from DataRow; the CA1305/CA1307/CA1310 family wants explicit culture and comparison on strings
    inside assertions, where neither is a risk. Scoped by project name so it cannot leak into the
    product assemblies.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Test'))">
    <NoWarn>$(NoWarn);CA1062;CA1305;CA1307;CA1310;CA1861</NoWarn>
  </PropertyGroup>

</Project>
