<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <!--
    Everything tested here is pure logic with no hardware, no UI and no host:
      ChessHelpers    - FEN/SAN inference and normalisation
      DgtAngelShared  - the JSON wire contracts with the browser extension
      UciComms        - UCI protocol parsing and engine lifecycle

    Deliberately kept off WinForms/ASP.NET Core/gRPC so this suite builds and
    runs in about a second. Anything needing those belongs in DgtCherubTest.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ChessHelpers\ChessHelpers.csproj" />
    <ProjectReference Include="..\DgtAngelShared\DgtAngelShared.csproj" />
    <ProjectReference Include="..\UciComms\UciComms.csproj" />
  </ItemGroup>

</Project>
